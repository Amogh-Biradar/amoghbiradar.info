RewriteEngine On

# Serve the portfolio from one hostname only. This also catches the hosting
# provider's autodiscover hostname when it reaches this document root.
RewriteCond %{HTTP_HOST} !^amoghbiradar\.info$ [NC]
RewriteRule ^ https://amoghbiradar.info%{REQUEST_URI} [R=301,L,NE]

# HTML must be revalidated so a browser cannot show the retired site on the
# first visit and only fetch the current site after a manual reload.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:html?|xml|txt)$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>
</IfModule>
